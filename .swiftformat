# SwiftFormat configuration for TokenMon.
# Complements SwiftLint: this file controls formatting, SwiftLint controls rules.

--swiftversion 5.10
--exclude build,dist,.build,DerivedData

# Rules disabled because they conflict with this codebase's formatting style:
--disable \
  blankLinesBetweenScopes, \
  conditionalAssignment, \
  consecutiveSpaces, \
  docComments, \
  hoistTry, \
  indent, \
  noForceUnwrapInTests, \
  numberFormatting, \
  redundantClosure, \
  redundantMemberwiseInit, \
  redundantReturn, \
  redundantSelf, \
  redundantStaticSelf, \
  redundantThrows, \
  redundantType, \
  redundantVariable, \
  redundantViewBuilder, \
  spaceAroundOperators, \
  trailingCommas, \
  unusedArguments, \
  andOperator, \
  wrapFunctionBodies, \
  wrapIfStatementBodies, \
  wrapLoopBodies, \
  wrapMultilineStatementBraces, \
  wrapPropertyBodies
